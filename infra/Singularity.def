Bootstrap: docker
# Deliberately a -devel (not -runtime) base: it ships the CUDA toolkit (nvcc,
# headers) so JIT-compiled ops (e.g. DeepSpeed fused kernels) build inside the
# image and the launcher no longer needs to bind-mount the host toolkit. Costs
# a few GB of image size.
From: nvidia/cuda:12.6.1-devel-ubuntu22.04

%setup
    # Build with apptainer, not singularity: only apptainer sets
    # APPTAINER_ROOTFS. Abort loudly if it is missing -- otherwise the paths
    # below resolve to /workspace/... on the HOST and the image would ship an
    # empty project. (infra/setup/build_singularity.sh loads the module.)
    set -eu
    : "${APPTAINER_ROOTFS:?not set -- build with apptainer (module load apptainer)}"
    mkdir -p ${APPTAINER_ROOTFS}/usr/local/share/uv/cache
    mkdir -p ${APPTAINER_ROOTFS}/workspace/training
    # NOT -L: dereferencing symlinks pulls whole external trees into the image
    # (a scratch symlink in the repo root once dragged in 100GB+ of datasets).
    # --safe-links drops any symlink escaping the repo instead of following it.
    rsync -a --safe-links --exclude-from=.singularityignore . ${APPTAINER_ROOTFS}/workspace/training/

%environment
    export PATH=$PATH:/usr/local/bin
    export UV_PYTHON_INSTALL_DIR=/usr/local/share/uv/python
    export VENV_PATH=/workspace/venv/bin/activate
    # So JIT builds (e.g. DeepSpeed fused ops) find the toolkit shipped in the -devel base.
    export CUDA_HOME=/usr/local/cuda
    
%post
    #!/bin/bash
    set -eux

    export UV_PYTHON_INSTALL_DIR=/usr/local/share/uv/python
    export UV_INSTALL_DIR=/usr/local/bin
    export PATH=$PATH:/usr/local/bin

    apt-get update
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        git build-essential curl ca-certificates \
        && rm -rf /var/lib/apt/lists/*

    curl -LsSf https://astral.sh/uv/install.sh | sh
    /usr/local/bin/uv --version
    
    /usr/local/bin/uv python install 3.12.9
    # Verify installation
    /usr/local/bin/uv python list

    cd /workspace/training
    
    # Create the venv outside the project directory so it won't be hidden
    # when /workspace/training is bind-mounted from the host.
    /usr/local/bin/uv venv /workspace/venv --python 3.12.9
    export UV_PROJECT_ENVIRONMENT=/workspace/venv

    # Install the package. --extra flash-attn is required: the configs request
    # attn_implementation=flash_attention_2 and there is no sdpa fallback, but
    # flash-attn is an optional extra in pyproject.toml so a plain `uv sync`
    # would silently omit it. The extra resolves to a pinned prebuilt wheel
    # (see [tool.uv.sources]), so this is a download, not a source build.
    # --locked: install exactly what uv.lock records instead of re-resolving.
    # A bare `uv sync` here once let the image and CI (`pip install -e .`)
    # silently diverge on lhotse/torchdata versions -- see the transformers 5
    # migration notes. If pyproject.toml and uv.lock disagree, this fails
    # loudly instead of building a different image than the lock describes.
    /usr/local/bin/uv sync --locked --python 3.12 --link-mode copy --cache-dir /usr/local/share/uv/cache --no-editable --index-strategy unsafe-best-match --extra flash-attn

    # test torch installation
    /usr/local/bin/uv run python -c "import torch; print(torch.__version__)"